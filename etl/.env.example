# ==============================================================================
# ШАБЛОН ОКРУЖЕНИЯ. Копировать в .env и заполнить.
#
# ВСЕ СЕКРЕТЫ НАМЕРЕННО ПУСТЫЕ.
# Пустой обязательный секрет = сервис не стартует (pydantic: Field required).
# Значения из этого файла НЕ являются валидными секретами.
#
#   Автоматически:  ./gen_env.sh
# ==============================================================================

# --- 1. ОБЩИЕ НАСТРОЙКИ ---
PROJECT_NAME="Movie theater"
PROJECT_DESCRIPTION="The best movie theater for everyone"
DEBUG=False
DATABASE_TYPE=postgres
PROJECT_NAME_FASTAPI=movies

# --- 2. СЕТЕВАЯ БЕЗОПАСНОСТЬ ---
# Секрет Django: сессии, CSRF, signing. Сгенерировать: openssl rand -hex 32
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8080,http://localhost:8080

# --- 3. ОСНОВНАЯ БД ---
SQL_ENGINE=django.db.backends.postgresql_psycopg2
POSTGRES_HOST=theatre-db
POSTGRES_PORT=5432
POSTGRES_DB=theatre
POSTGRES_USER=postgres
# Пароль суперпользователя БД. Применяется только при ПЕРВОМ старте
# (пустой volume). Смена в .env позже пароль в БД не меняет.
POSTGRES_PASSWORD=
POSTGRES_OPTIONS=-c search_path=public,content

# --- 4. БД AUTH-СЕРВИСА ---
POSTGRES_AUTH_HOST=theatre-db
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DB=auth_service_db
POSTGRES_AUTH_SCHEMA=auth
# Владелец схемы (DDL, для Alembic)
POSTGRES_AUTH_USER=auth_admin
POSTGRES_AUTH_PASSWORD=
# Пользователь приложения (без DDL) — принцип наименьших привилегий
POSTGRES_AUTH_APP_USER=auth_app
POSTGRES_AUTH_APP_PASSWORD=

# --- 5. ELASTICSEARCH ---
ELASTIC_HOST=elasticsearch
ELASTIC_PORT=9200
ELASTIC_SCHEMA=http://

# --- 6. REDIS ---
# 6.1. Основной кэш
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSW=
REDIS_CACHE_DB=0

# 6.2. Выделенный Redis для auth-состояния (blacklist / user_ver / perms)
REDIS_AUTH_HOST=auth-redis
REDIS_AUTH_PORT=6380
REDIS_AUTH_PASSW=
REDIS_AUTH_DB=1

# 6.3. Счётчики статистики (отдельный инстанс, только dev-стенд)
STATS_REDIS_HOST=stats-redis
STATS_REDIS_PORT=6381
STATS_REDIS_PASSW=

# 6.4. Rate limiting
# ВНИМАНИЕ: это ТОТ ЖЕ инстанс Redis, что и 6.1 (redis:6379),
# поэтому RATELIMIT_REDIS_PASSW ОБЯЗАН совпадать с REDIS_PASSW.
RATELIMIT_REDIS_HOST=redis
RATELIMIT_REDIS_PORT=6379
RATELIMIT_REDIS_PASSW=
RATELIMIT_REDIS_DB=2

# --- 7. СЕКРЕТЫ АВТОРИЗАЦИИ ---
# Общий ключ подписи JWT: auth-service, fastapi, ugc-api, Django.
# Пусто -> сервисы не стартуют. Значение из примера использовать НЕЛЬЗЯ:
# зная ключ, любой может подписать токен с чужим sub, и ugc-api
# свяжет событие с чужой учётной записью.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256

# "Перец": sha256(password + pepper) -> bcrypt.
# ВНИМАНИЕ: смена pepper делает ВСЕ существующие хеши паролей
# непроверяемыми — войти не сможет никто. Задаётся один раз
# при первом развёртывании и далее не меняется.
PASSWORD_PEPPER=

# Служебный ключ для /api/v1/internal/* (fastapi -> auth-service).
# Должен совпадать в обоих сервисах.
INTERNAL_API_KEY=

# TTL токенов и защита от брутфорса
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
LOGIN_FAILED_THRESHOLD=5
LOGIN_FAILED_WINDOW_SEC=300
LOGIN_LOCKOUT_SEC=900
RATE_LIMIT_ENABLED=True

# --- 8. БИЗНЕС-ЛОГИКА ---
AUTH_SERVICE_URL=http://auth-service:8001
PERMS_CACHE_TTL_SECONDS=900
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# --- 9. ТЕЛЕМЕТРИЯ ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4317

# --- 10. СТАРТОВЫЕ СКРИПТЫ ---
FAILED_TIMEOUT=7
SLEEP_TIME=5
BATCH_SIZE=200

# --- 11. ПРЕФИКСЫ КЛЮЧЕЙ REDIS ---
FAILED_ATTEMPTS_PREFIX=auth:failed
LOCKOUT_PREFIX=auth:lockout

# --- 12. YANDEX OAUTH (заполнить вручную из кабинета Яндекса) ---
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1/auth/callback
YANDEX_AUTH_URL=https://oauth.yandex.ru/authorize
YANDEX_TOKEN_URL=https://oauth.yandex.ru/token
YANDEX_INFO_URL=https://login.yandex.ru/info

# VK не реализован — оставить пустым
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=http://127.0.0.1/auth/callback

# --- 13. CLICKHOUSE (UGC, sprint 8) ---
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=ugc
CLICKHOUSE_USER=ugc
# Обязателен: compose использует ${CLICKHOUSE_PASSWORD:?...},
# ugc-etl и ugc-migrations без него не стартуют.
# Применяется только при ПЕРВОМ старте (пустой volume).
CLICKHOUSE_PASSWORD=

# --- 14. GRAFANA / UGC-ЛИМИТЫ ---
GRAFANA_PASS=
UGC_MEMORY_HARD_LIMIT_MB=384